{
  "_guide": {
    "about": "Full sample for tenant workflow import. It shows every supported section and option, so copy it, keep what your workflow needs and delete the rest. Keys starting with '_' are ignored by the importer.",
    "howToUse": [
      "1. Set 'code' to one of the available workflow codes and 'domainService' to that code's domain (see availableWorkflowCodes).",
      "2. Replace every 00000000-0000-0000-0000-000000000000 with a real role id (assignmentType Role) or user id (assignmentType User).",
      "3. Keep 'status' as Draft while editing. Published or Active requires real participant ids in every step.",
      "4. Remove the steps, fields, rules, notifications and escalations you do not need. Only code, name, domainService, version, tags and at least one step are required.",
      "5. Validate with POST .../import/json/validate, then import with POST .../import/json/process."
    ],
    "tenancy": "tenantId and subTenantId below are dummy values. On upload the front end replaces them with the logged-in user's tenant and sub-tenant from the token, so leave them as they are.",
    "notFromFile": "publishedBy and publishedAt are set from the logged-in user, not from this file.",
    "rules": [
      "Step codes must be unique in the workflow, and status codes must be unique in their step.",
      "Every step needs at least one status, exactly one status with isDefault true, and exactly one with isTerminal true.",
      "Every non-terminal status needs at least one allowed outgoing transition.",
      "statusTransitions must only reference statusCode values defined in the same step.",
      "A transition from a status with statusCode 'PENDING' automatically gets the reason SYSTEM_ESCALATION_TIMEOUT.",
      "Steps run in stepOrder. collaborationMode Consensus needs the runtime to track each participant's completion.",
      "If a central workflow with the same code exists, the version is raised above the central version automatically (the result row says so).",
      "Each imported workflow gets a new id generated by the configuration service; an 'id' in the file is ignored.",
      "The same code and version cannot be imported twice unless conflictMode is SkipExisting, CreateNextVersion or OverwriteDraft."
    ],
    "availableWorkflowCodes": {
      "EmployeeMaster": [
        "EmployeeMasterTransfer",
        "EmployeeMasterOnboarding",
        "EmployeeMasterOffboarding",
        "EmployeeMasterDelegation",
        "EmployeeMasterPromotion",
        "EmployeeMasterDemotion"
      ],
      "PerformanceService": [
        "EmployeePerformancePerformanceGoal",
        "EmployeePerformanceDevelopmentPlan",
        "EmployeePerformanceReadinessEvaluation"
      ],
      "note": "The live list is managed centrally; only codes with status Active are accepted."
    },
    "allowedValues": {
      "status": [ "Draft", "Published", "Active", "Inactive", "Deprecated", "Archived" ],
      "collaborationMode": [ "Sequential", "Parallel", "Consensus" ],
      "assignmentType": [ "Role", "User", "Conditional" ],
      "logic": [ "Manual", "All", "Majority", "Any" ],
      "fieldType": [ "Text", "Textarea", "Number", "Date", "DateTime", "Dropdown", "MultiSelect", "Grid", "Questionnaire", "FileUpload", "Checkbox", "Radio", "Switch", "Rating", "Milestone", "Competency" ],
      "fieldTypesThatNeedSource": [ "Dropdown", "MultiSelect", "Grid", "Questionnaire", "Competency", "Milestone" ],
      "validationType": [ "Required", "MinLength", "MaxLength", "MinValue", "MaxValue", "Regex", "Email", "Phone", "DateRange", "Custom" ],
      "ruleType": [ "Validation", "Assignment", "Notification", "Escalation", "Branch" ],
      "notificationType": [ "Role", "User", "Conditional" ],
      "notificationTrigger": [ "ON_WORKFLOW_STARTED", "ON_STEP_START", "ON_STATUS_ENTER", "ON_WORKFLOW_COMPLETED", "TIMEOUT" ],
      "notificationTemplate": [ "workflow-task-initiated", "workflow-task-progressed", "user-account-created-template" ],
      "channel": [ "Email", "InApp", "Sms" ],
      "escalationType": [ "Notification", "System", "Hierarchy" ],
      "escalationTrigger": [ "TIMEOUT", "WORKFLOW_TIMEOUT" ],
      "escalationAction": [ "NOTIFY:<TEMPLATE_OR_ROLE>", "REASSIGN", "AUTO_APPROVE", "LOG_ESCALATION", "BLOCK_ALL_ACTIONS" ],
      "ruleAction": [ "VALIDATE_WORKFLOW", "BLOCK_SAVE", "NOTIFY:<TEMPLATE_OR_ROLE>", "ASSIGN:<ROLE>", "GOTO_STEP:<STEP_CODE>" ],
      "afterDuration": "TimeSpan 'd.hh:mm:ss' (e.g. 2.00:00:00), ISO 8601 (e.g. PT48H), or a number of hours (e.g. 48)",
      "dates": "ISO 8601, e.g. 2026-01-01T00:00:00Z"
    }
  },
