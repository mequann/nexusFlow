NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Storage backend: "postgres" | "memory"
# Set STORAGE_DRIVER=postgres and provide either DATABASE_URL OR the individual DB_* variables below.
STORAGE_DRIVER=postgres

# Option A: Full PostgreSQL connection URI (takes precedence if set)
DATABASE_URL=postgres://nexusflow:nexusflow@localhost:5432/nexusflow

# Option B: Granular PostgreSQL connection settings (used when DATABASE_URL is omitted)
DB_HOST=localhost
DB_PORT=5432
DB_USER=nexusflow
DB_PASSWORD=nexusflow
DB_NAME=nexusflow
DB_SSL=false
DB_POOL_MAX=20

# Redis (optional; enables distributed rate-limiting & caching)
REDIS_URL=redis://localhost:6379

# Security (override all secrets in production!)
JWT_SECRET=dev-jwt-secret-change-me-in-production-32chars
JWT_ISSUER=nexusflow
JWT_AUDIENCE=nexusflow-api
# 32-byte hex key (64 hex chars) for AES-256-GCM Credential Vault
VAULT_MASTER_KEY_V1=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
VAULT_ACTIVE_KEY_ID=v1

# Workers
ENABLE_EMBEDDED_WORKERS=true
WORKER_POLL_INTERVAL_MS=250
WORKER_CONCURRENCY=8
OUTBOX_POLL_INTERVAL_MS=500
TIMER_POLL_INTERVAL_MS=1000

# SSRF protection for action.http nodes (set false in prod)
ALLOW_PRIVATE_NETWORK_HTTP=false

# Seed bootstrap admin user on startup if empty (for local/dev)
BOOTSTRAP_ADMIN_EMAIL=admin@nexusflow.local
BOOTSTRAP_ADMIN_PASSWORD=AdminChangeMe123!
