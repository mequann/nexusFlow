NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Storage backend: "postgres" | "memory"
# Set STORAGE_DRIVER=postgres and provide either DATABASE_URL OR the individual DB_* variables below.
STORAGE_DRIVER=postgres

# Option A: Full PostgreSQL connection URI (takes precedence if set)
DATABASE_URL=postgres://nexusflow:nexusflow@localhost:5432/nexusflow

# Option B: Granular PostgreSQL connection settings (used when DATABASE_URL is omitted)
DB_HOST=localhost
DB_PORT=5432
DB_USER=nexusflow
DB_PASSWORD=nexusflow
DB_NAME=nexusflow
DB_SSL=false
DB_POOL_MAX=20

# Redis (optional; enables distributed rate-limiting & caching)
REDIS_URL=redis://localhost:6379

# Security (override all secrets in production!)
JWT_SECRET=dev-jwt-secret-change-me-in-production-32chars
JWT_ISSUER=nexusflow
JWT_AUDIENCE=nexusflow-api
# 32-byte hex key (64 hex chars) for AES-256-GCM Credential Vault
VAULT_MASTER_KEY_V1=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
VAULT_ACTIVE_KEY_ID=v1

# Workers
ENABLE_EMBEDDED_WORKERS=true
WORKER_POLL_INTERVAL_MS=250
WORKER_CONCURRENCY=8
OUTBOX_POLL_INTERVAL_MS=500
TIMER_POLL_INTERVAL_MS=1000

# SSRF protection for action.http nodes (set false in prod)
ALLOW_PRIVATE_NETWORK_HTTP=false

# Seed bootstrap admin user on startup if empty (for local/dev)
BOOTSTRAP_ADMIN_EMAIL=admin@nexusflow.local
BOOTSTRAP_ADMIN_PASSWORD=AdminChangeMe123!

# ==============================================================================
# Tier-1 Enterprise: Pluggable Document Storage Vault
# ==============================================================================
# Storage Driver: "local" (default zero-config NVMe) | "database" (PostgreSQL binary chunks) | "s3_compatible"
FILE_STORAGE_DRIVER=local
FILE_STORAGE_LOCAL_DIR=./data/storage

# S3-Compatible Endpoint (AWS S3, Cloudflare R2, Ethio Telecom telecloud, or on-prem MinIO/Ceph)
# Examples:
#   Ethio Telecom Cloud: FILE_STORAGE_S3_ENDPOINT=https://s3.telecloud.et
#   Cloudflare R2:       FILE_STORAGE_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   Local MinIO:         FILE_STORAGE_S3_ENDPOINT=http://localhost:9000
#   AWS S3:              FILE_STORAGE_S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
# FILE_STORAGE_S3_ENDPOINT=
FILE_STORAGE_S3_BUCKET=nexusflow-documents
FILE_STORAGE_S3_ACCESS_KEY=
FILE_STORAGE_S3_SECRET_KEY=
FILE_STORAGE_S3_REGION=us-east-1
FILE_STORAGE_S3_FORCE_PATH_STYLE=true

# ==============================================================================
# Tier-1 Enterprise: Distributed Multi-Node Concurrency & Cluster Lock
# ==============================================================================
# Lock Driver: "postgres_advisory" (default, zero extra servers) | "redis" | "memory"
CLUSTER_LOCK_DRIVER=postgres_advisory

# ==============================================================================
# Tier-1 Enterprise: Single Sign-On (SSO) & Identity Federation
# ==============================================================================
SSO_ENABLED=true
# SSO_OIDC_ISSUER_URL=https://sso.enterprise.et/auth/realms/nexusflow
# SSO_OIDC_CLIENT_ID=nexusflow-client
# SSO_OIDC_CLIENT_SECRET=

